# sfwbar: openbox/tint2-style taskbar for the labwc session.
# Installed as /etc/xdg/sfwbar/sfwbar.config.
#
# Left:   Start button (sfwbar's built-in application menu, generated from the
#         installed .desktop files, so new applications appear automatically),
#         terminal, files, then the window buttons of running applications.
# Right:  tray, network, volume, battery (auto-hidden when there is none), clock.
#
# The bar is a Wayland layer-shell surface; window buttons and the window menu
# come from the compositor's foreign-toplevel protocol, which labwc implements.

Set Term = "foot"

# Place new windows cascading instead of stacking them on top of each other.
placer {
  xorigin = 5
  yorigin = 5
  xstep = 5
  ystep = 5
  children = true
}

# Alt-Tab style switcher.
switcher {
  interval = 700
  icons = true
  labels = false
  cols = 5
}

include("winops.widget")

layout {
  mirror = "*"
  layer = "top"
  bar_id = "bar-0"

  # Start menu button (opens the "app_menu_system" menu).
  include("startmenu.widget")

  button {
    style = "launcher"
    value = "utilities-terminal"
    action = Exec $Term
    tooltip = "Terminal"
  }

  button {
    style = "launcher"
    value = "system-file-manager"
    action = Exec "pcmanfm"
    tooltip = "Files"
  }

  # Window list. Right-click opens the window menu, middle-click closes,
  # dragging a button focuses that window.
  taskbar {
    rows = 1
    css = "* { -GtkWidget-hexpand: true; -FlowGrid-column-homogeneous: true; }"
    labels = false
    group = pager
    group icons = true
    group labels = true
    sort = true

    action[RightClick] = Menu "winops"
    action[MiddleClick] = Close
    action[Drag] = Focus
  }

  tray {
    rows = 1
  }

  include("network-module.widget")
  include("volume.widget")
  include("battery-svg.widget")

  label {
    interval = 1000
    value = Time("%a %d %b  %H:%M")
    css = "label { padding-left: 8px; padding-right: 8px; }"
  }
}

# CSS: Catppuccin Mocha, matching the previous bar (#1e1e2e / #cdd6f4 / #89b4fa).
@define-color theme_text_color #cdd6f4;
@define-color theme_bg_color #1e1e2e;
@define-color theme_fg_color #cdd6f4;
@define-color borders rgba(137,180,250,0.25);

window#sfwbar {
  -GtkWidget-direction: top;
  background-color: #1e1e2e;
  border-bottom: 1px solid rgba(137,180,250,0.20);
}

grid#layout {
  -GtkWidget-direction: right;
  min-height: 30px;
}

grid {
  padding: 0px;
  margin: 0px;
}

* {
  font-family: "Noto Sans", "DejaVu Sans", sans-serif;
  font-size: 13px;
  -GtkWidget-vexpand: true;
}

label {
  color: @theme_text_color;
  text-shadow: none;
}

image {
  min-width: 18px;
  min-height: 18px;
  box-shadow: none;
  border: none;
  border-image: none;
  background-image: none;
  background: none;
  -gtk-icon-shadow: none;
}

button {
  box-shadow: none;
  border-image: none;
  background-image: none;
  background: none;
  outline-style: none;
  border: none;
  padding: 0px 3px 0px 3px;
  -GtkWidget-valign: center;
  border-radius: 4px;
}

button:hover {
  background-color: rgba(137,180,250,0.22);
}

#hidden {
  -GtkWidget-visible: false;
}

#startmenu,
#module,
#launcher {
  padding: 0px 3px 0px 3px;
  border: none;
  -GtkWidget-valign: center;
}

#startmenu image,
#module image {
  -ScaleImage-color: @theme_text_color;
  -ScaleImage-symbolic: true;
}

#startmenu image {
  min-width: 18px;
  min-height: 18px;
  padding: 1px;
}

menu {
  background-color: #1e1e2e;
  border: 1px solid @borders;
  padding: 3px;
}

menu arrow {
  background-color: rgba(0,0,0,0);
  color: @theme_text_color;
}

menuitem {
  color: @theme_text_color;
  padding: 3px 6px 3px 6px;
  border-radius: 4px;
}

menuitem:hover {
  background-color: rgba(137,180,250,0.30);
}

menu image {
  padding-right: 5px;
}

tooltip {
  background-color: #313244;
  color: @theme_text_color;
}

button#taskbar_item image {
  min-width: 20px;
  min-height: 20px;
}

button#taskbar_item label {
  padding: 0px 0px 0px 5px;
  -GtkWidget-hexpand: false;
}

button#taskbar_item {
  padding: 0px 5px 0px 5px;
  border-radius: 4px;
  background-color: rgba(49,50,68,0.85);
  -GtkWidget-hexpand: false;
}

button#taskbar_item.focused {
  background-color: rgba(137,180,250,0.45);
}

button#taskbar_item:hover {
  background-color: rgba(137,180,250,0.25);
}

grid#taskbar_pager {
  padding-right: 3px;
  padding-left: 3px;
  border-radius: 4px;
  border: solid rgba(137,180,250,0.20) 1px;
}

button#pager {
  padding: 0px 5px 0px 5px;
  border-radius: 4px;
}

button#tray_item {
  padding: 0px 1px 0px 0px;
  border: none;
  margin: 0px;
  -GtkWidget-valign: center;
}

button#tray_item.passive {
  -GtkWidget-visible: false;
}
