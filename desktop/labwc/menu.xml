<?xml version="1.0" encoding="UTF-8"?>
<!-- Right-click desktop menu for labwc (Openbox menu format).
     Kept deliberately small: every entry maps to a package installed by the
     Containerfile. -->
<openbox_menu xmlns="http://openbox.org/3.4/menu">
  <menu id="root-menu" label="labwc">
    <item label="Files">
      <action name="Execute" command="thunar" />
    </item>
    <item label="Terminal">
      <action name="Execute" command="foot" />
    </item>
    <separator />
    <menu id="accessories" label="Accessories">
      <item label="Image Viewer">
        <action name="Execute" command="gthumb" />
      </item>
      <item label="Text Editor">
        <action name="Execute" command="mousepad" />
      </item>
      <item label="Archive Manager">
        <action name="Execute" command="xarchiver" />
      </item>
      <item label="Document Viewer">
        <action name="Execute" command="evince" />
      </item>
      <item label="Screenshot">
        <action name="Execute" command="grim -g \"$(slurp)\" - | wl-copy" />
      </item>
      <item label="Clipboard History">
        <action name="Execute" command="wl-paste" />
      </item>
    </menu>
    <menu id="graphics" label="Graphics">
      <item label="GThumb">
        <action name="Execute" command="gthumb" />
      </item>
      <item label="Simple Scan">
        <action name="Execute" command="simple-scan" />
      </item>
      <item label="NAPS2">
        <action name="Execute" command="naps2" />
      </item>
    </menu>
    <menu id="printing" label="Printing">
      <item label="Print Jobs (cancel)">
        <action name="Execute" command="fuzzel-printjobs" />
      </item>
      <item label="Cancel All Print Jobs">
        <action name="Execute" command="foot -e fuzzel-printjobs cancel-all" />
      </item>
      <item label="Manage Printing (CUPS)">
        <action name="Execute" command="xdg-open http://localhost:631/" />
      </item>
    </menu>
    <menu id="internet" label="Internet">
      <item label="WeeChat">
        <action name="Execute" command="foot -e weechat" />
      </item>
    </menu>
    <menu id="multimedia" label="Multimedia">
      <item label="PulseAudio Volume Control">
        <action name="Execute" command="pavucontrol" />
      </item>
    </menu>
    <menu id="settings" label="Settings">
      <item label="Wallpaper">
        <action name="Execute" command="wpg --gtk" />
      </item>
      <item label="Night Light">
        <action name="Execute" command="wlsunset -l 40.7 -L -74.0 -t 4500" />
      </item>
      <separator />
      <item label="Displays">
        <action name="Execute" command="wdisplays" />
      </item>
      <item label="Network Connections">
        <action name="Execute" command="nm-connection-editor" />
      </item>
      <item label="Power Manager">
        <action name="Execute" command="xfce4-power-manager-settings" />
      </item>
      <separator />
      <item label="Volume Control">
        <action name="Execute" command="pavucontrol" />
      </item>
    </menu>
    <menu id="system" label="System">
      <item label="Task Manager (btop)">
        <action name="Execute" command="foot -e btop" />
      </item>
      <item label="Disk Usage Analyzer">
        <action name="Execute" command="baobab" />
      </item>
      <separator />
      <item label="Flatpak Permissions">
        <action name="Execute" command="flatseal" />
      </item>
      <item label="Partition Manager">
        <action name="Execute" command="gparted" />
      </item>
      <item label="Font Viewer">
        <action name="Execute" command="gnome-font-viewer" />
      </item>
      <separator />
      <item label="Reconfigure labwc">
        <action name="Reconfigure" />
      </item>
      <item label="Exit to greeter">
        <action name="Exit" />
      </item>
      <item label="Reboot">
        <action name="Execute" command="systemctl reboot" />
      </item>
      <item label="Shut down">
        <action name="Execute" command="systemctl poweroff" />
      </item>
    </menu>
  </menu>
</openbox_menu>
