{
  "layer": "top",
  "position": "top",
  "height": 30,
  "spacing": 6,
  "modules-left": ["custom/menu", "custom/files", "wlr/workspaces", "wlr/taskbar"],
  "modules-center": ["clock"],
  "modules-right": ["pulseaudio", "network", "battery", "tray"],
  "custom/menu": {
    "format": "Menu",
    "tooltip": "Applications (fuzzel)",
    "on-click": "fuzzel"
  },
  "custom/files": {
    "format": "Files",
    "tooltip": "Open Thunar",
    "on-click": "thunar"
  },
  "wlr/workspaces": {
    "format": "{name}",
    "on-click": "activate"
  },
  "wlr/taskbar": {
    "format": "{icon}",
    "icon-size": 16,
    "icon-theme": "Adwaita",
    "tooltip-format": "{title}",
    "tooltip": true,
    "on-click": "activate",
    "on-click-middle": "close",
    "on-click-right": "fullscreen"
  },
  "clock": {
    "format": "{:%a %d %b  %H:%M}",
    "tooltip-format": "{:%Y-%m-%d %H:%M:%S}"
  },
  "network": {
    "format-wifi": "WIFI {essid}",
    "format-ethernet": "NET {ifname}",
    "format-disconnected": "NET OFF",
    "tooltip-format": "{ifname}: {ipaddr}/{cidr}"
  },
  "pulseaudio": {
    "format": "VOL {volume}%",
    "format-muted": "MUTE"
  },
  "battery": {
    "format": "BAT {capacity}%",
    "states": {
      "warning": 20,
      "critical": 10
    },
    "format-warning": "BAT {capacity}% LOW",
    "format-critical": "BAT {capacity}% CRIT"
  },
  "tray": {
    "spacing": 8
  }
}
