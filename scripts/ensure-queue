#!/usr/bin/env bash
# Create the PAPPL queue for the Konica bizhub 206 if the USB device is present.
#
# Safe to run at every boot and from udev: it exits 0 when no printer is
# attached or the queue already exists. No paper is used.
set -euo pipefail

QUEUE=${KONICA_QUEUE:-konica206}
PORT=${KONICA_PORT:-8001}
VENDOR=132b
PRODUCT=232b
URI_BASE="ipp://localhost:${PORT}"

log() { printf 'konica206-queue: %s\n' "$*"; }

# CUPS queue for desktop applications. The PAPPL application is an IPP server,
# but CUPS needs a local queue with a PPD before anything can print through it.
# The shipped PPD is a shim: it declares the ten real page sizes of the device
# (no CUPS-generated ".Borderless" entries) and offers simplex and duplex.
# The app PPD adds a PDF duplex shim so PPD-only clients (Duplex=) work, while
# the PAPPL (IPP) backend receives image/urf.
CUPS_QUEUE=${KONICA_CUPS_QUEUE:-konica206}
PPD=/usr/share/ppd/konica206/konica206-app.ppd

# True when the queue's installed PPD is byte-identical to the image PPD.
ppd_current() {
    local queue="$1" src="$2"
    cmp -s "/etc/cups/ppd/${queue}.ppd" "$src"
}

# True when the queue has a pending or processing job. Reloading a PPD makes
# CUPS restart that job, so an update must wait until the queue is idle.
queue_busy() {
    local queue="$1"
    lpstat -o "$queue" 2>/dev/null | grep -q .
}

ensure_cups_queue() {
    [ -r "$PPD" ] || { log "no PPD at $PPD; skipping CUPS queue"; return 0; }

    systemctl start cups.socket >/dev/null 2>&1 || true

    local want_uri="ipp://127.0.0.1:${PORT}/ipp/print/${QUEUE}"

    if lpstat -p "$CUPS_QUEUE" >/dev/null 2>&1; then
        # Repair a misconfigured queue (e.g. file:///dev/null, not accepting).
        local cur_uri
        cur_uri=$(lpstat -v "$CUPS_QUEUE" 2>/dev/null | sed 's/^[^:]*: //')
        if [[ $cur_uri != "$want_uri" ]]; then
            lpadmin -p "$CUPS_QUEUE" -v "$want_uri" \
                -D "KONICA MINOLTA bizhub 206" -L "Local USB" \
                -o printer-error-policy=retry-job >/dev/null 2>&1 \
                && log "CUPS queue '$CUPS_QUEUE' device set to $want_uri"
        fi
        cupsenable "$CUPS_QUEUE" >/dev/null 2>&1 || true
        cupsaccept "$CUPS_QUEUE" >/dev/null 2>&1 || true

        # Never reload an unchanged PPD. udev runs this script on every USB
        # re-enumeration, including the printer waking up in the middle of a
        # job, and CUPS restarts the active job whenever a printer's PPD
        # changes ("Job restarted because the printer was modified" in
        # scheduler/ipp.c). The restarted job is submitted to PAPPL again and
        # prints a second time. Only touch the PPD when it really differs,
        # and never while the queue is busy.
        if ppd_current "$CUPS_QUEUE" "$PPD"; then
            log "CUPS queue '$CUPS_QUEUE' is up to date"
        elif queue_busy "$CUPS_QUEUE"; then
            log "CUPS queue '$CUPS_QUEUE' is busy; deferring PPD update"
        else
            lpadmin -p "$CUPS_QUEUE" -P "$PPD" >/dev/null 2>&1 \
                && log "CUPS queue '$CUPS_QUEUE' refreshed with $PPD"
        fi
        return 0
    fi

    lpadmin -p "$CUPS_QUEUE" -E \
        -v "ipp://127.0.0.1:${PORT}/ipp/print/${QUEUE}" \
        -P "$PPD" \
        -D "KONICA MINOLTA bizhub 206" -L "Local USB" \
        -o printer-error-policy=retry-job >/dev/null 2>&1 \
        && log "CUPS queue '$CUPS_QUEUE' created (A4, simplex)" \
        || { log "could not create CUPS queue '$CUPS_QUEUE'"; return 0; }

    # Persisted defaults: A4 paper, one-sided. Both can still be overridden
    # per job (-o PageSize=A3, -o Duplex=DuplexNoTumble) or in the print dialog.
    # Apply them only on creation so a later USB event cannot overwrite the
    # user's choices.
    lpadmin -p "$CUPS_QUEUE" -o PageSize=A4 -o Duplex=None >/dev/null 2>&1 \
        && log "defaults applied: PageSize=A4 Duplex=None"
}

# PAPPL 1.4.x ignores `-u` for the `printers` sub-command: it starts a second
# local server on port 8001, which fails with "Address already in use" while
# the real server is running. That made this helper exit early on every USB
# event, so the PPD below was never refreshed and PPD-only duplex jobs printed
# an upside-down back page. Query the live server over IPP instead;
# CUPS-Get-Printers is read-only.
pappl_printers() {
    if command -v ipptool >/dev/null 2>&1; then
        local out
        out=$(timeout 10 ipptool -tv "$URI_BASE/" <(cat <<'IPP'
{
  NAME "List PAPPL printers"
  OPERATION CUPS-Get-Printers
  GROUP operation-attributes-tag
  ATTR charset attributes-charset utf-8
  ATTR naturalLanguage attributes-natural-language en
  STATUS successful-ok
  DISPLAY printer-name
}
IPP
) 2>/dev/null) || return 1
        printf '%s\n' "$out" \
            | sed -n 's/^[[:space:]]*printer-name ([^)]*) = //p' | sort -u
        return 0
    fi
    # No ipptool: status -u still proves the server is alive. PAPPL creates
    # the queue from the USB serial at startup, so report it as present.
    timeout 10 /usr/bin/konica206-native status -u "$URI_BASE" >/dev/null 2>&1 \
        || return 1
    printf '%s\n' "$QUEUE"
}

# Wait briefly for the PAPPL server socket after boot. Bound each probe so a
# hung PAPPL client cannot stall the whole oneshot past its systemd timeout.
ready=0
for _ in $(seq 1 5); do
    if pappl_printers >/dev/null 2>&1; then
        ready=1
        break
    fi
    sleep 1
done
if ((ready == 0)); then
    log "PAPPL server at $URI_BASE is not responding; leaving queue creation to the next trigger"
    exit 0
fi

serial=${KONICA_SERIAL:-}
if [[ -z $serial ]]; then
    for dev in /sys/bus/usb/devices/*; do
        [[ -r "$dev/idVendor" && -r "$dev/idProduct" ]] || continue
        [[ $(<"$dev/idVendor") == "$VENDOR" ]] || continue
        [[ $(<"$dev/idProduct") == "$PRODUCT" ]] || continue
        if [[ -r "$dev/serial" ]]; then
            serial=$(<"$dev/serial")
            break
        fi
    done
fi

if [[ -z $serial ]]; then
    log "no bizhub 206 ($VENDOR:$PRODUCT) on USB; no queue created"
    exit 0
fi

# The serial is embedded in an IPP device URI. Only accept the character set
# real devices use, so a malformed sysfs value cannot inject URI syntax.
if [[ ! $serial =~ ^[A-Za-z0-9._-]+$ ]]; then
    log "refusing unexpected USB serial format: $serial"
    exit 1
fi

# Match the exact PAPPL printer name from the IPP query.
queue_present() {
    pappl_printers 2>/dev/null | grep -Fxq "$QUEUE"
}

if queue_present; then
    log "queue '$QUEUE' already exists"
    ensure_cups_queue
    exit 0
fi

log "creating queue '$QUEUE' for serial $serial"
# udev re-triggers this unit whenever the USB device is re-enumerated, and the
# server may already have the queue by the time we get here. Treat the
# resulting "already exists" as success instead of failing the unit.
if ! out=$(timeout 30 /usr/bin/konica206-native add \
        -d "$QUEUE" \
        -u "$URI_BASE" \
        -m konica-bizhub-206 \
        -v "konica://KONICA%20MINOLTA/206?serial=${serial}" 2>&1); then
    if printf '%s\n' "$out" | grep -qi 'already exists'; then
        log "queue '$QUEUE' already exists"
        ensure_cups_queue
        exit 0
    fi
    printf '%s\n' "$out" >&2
    exit 1
fi

log "queue created: ${URI_BASE}/ipp/print/${QUEUE}"
ensure_cups_queue
