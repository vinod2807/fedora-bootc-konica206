#!/usr/bin/env bash
# Create the PAPPL queue for the Konica bizhub 206 if the USB device is present.
#
# Safe to run at every boot and from udev: it exits 0 when no printer is
# attached or the queue already exists. No paper is used.
set -euo pipefail

QUEUE=${KONICA_QUEUE:-konica206}
PORT=${KONICA_PORT:-8001}
VENDOR=132b
PRODUCT=232b
URI_BASE="ipp://localhost:${PORT}"

log() { printf 'konica206-queue: %s\n' "$*"; }

# CUPS queue for desktop applications. The PAPPL application is an IPP server,
# but CUPS needs a local queue with a PPD before anything can print through it.
# The shipped PPD is a shim: it declares the ten real page sizes of the device
# (no CUPS-generated ".Borderless" entries) and offers simplex and duplex.
# Defaults are forced to A4 and one-sided on every run.
CUPS_QUEUE=${KONICA_CUPS_QUEUE:-konica206}
PPD=/usr/share/ppd/konica206/konica206.ppd

ensure_cups_queue() {
    [ -r "$PPD" ] || { log "no PPD at $PPD; skipping CUPS queue"; return 0; }

    systemctl start cups.socket >/dev/null 2>&1 || true

    if lpstat -p "$CUPS_QUEUE" >/dev/null 2>&1; then
        lpadmin -p "$CUPS_QUEUE" -P "$PPD" >/dev/null 2>&1 \
            && log "CUPS queue '$CUPS_QUEUE' refreshed with $PPD"
    else
        lpadmin -p "$CUPS_QUEUE" -E \
            -v "ipp://127.0.0.1:${PORT}/ipp/print/${QUEUE}" \
            -P "$PPD" \
            -D "KONICA MINOLTA bizhub 206" -L "Local USB" \
            -o printer-error-policy=retry-job >/dev/null 2>&1 \
            && log "CUPS queue '$CUPS_QUEUE' created (A4, simplex)" \
            || { log "could not create CUPS queue '$CUPS_QUEUE'"; return 0; }
    fi

    # Persisted defaults: A4 paper, one-sided. Both can still be overridden
    # per job (-o PageSize=A3, -o Duplex=DuplexNoTumble) or in the print dialog.
    lpadmin -p "$CUPS_QUEUE" -o PageSize=A4 -o Duplex=None >/dev/null 2>&1 \
        && log "defaults applied: PageSize=A4 Duplex=None"
}

# Wait briefly for the PAPPL server socket after boot.
ready=0
for _ in $(seq 1 30); do
    if /usr/bin/konica206-native printers -u "$URI_BASE" >/dev/null 2>&1; then
        ready=1
        break
    fi
    sleep 1
done
if ((ready == 0)); then
    log "PAPPL server at $URI_BASE is not responding; leaving queue creation to the next trigger"
    exit 0
fi

serial=${KONICA_SERIAL:-}
if [[ -z $serial ]]; then
    for dev in /sys/bus/usb/devices/*; do
        [[ -r "$dev/idVendor" && -r "$dev/idProduct" ]] || continue
        [[ $(<"$dev/idVendor") == "$VENDOR" ]] || continue
        [[ $(<"$dev/idProduct") == "$PRODUCT" ]] || continue
        if [[ -r "$dev/serial" ]]; then
            serial=$(<"$dev/serial")
            break
        fi
    done
fi

if [[ -z $serial ]]; then
    log "no bizhub 206 ($VENDOR:$PRODUCT) on USB; no queue created"
    exit 0
fi

# The serial is embedded in an IPP device URI. Only accept the character set
# real devices use, so a malformed sysfs value cannot inject URI syntax.
if [[ ! $serial =~ ^[A-Za-z0-9._-]+$ ]]; then
    log "refusing unexpected USB serial format: $serial"
    exit 1
fi

# The client lists one printer per line; match the first field so both a bare
# name and a decorated line ("konica206 (KONICA ...)") count as present.
queue_present() {
    /usr/bin/konica206-native printers -u "$URI_BASE" 2>/dev/null \
        | awk '{print $1}' | grep -Fxq "$QUEUE"
}

if queue_present; then
    log "queue '$QUEUE' already exists"
    ensure_cups_queue
    exit 0
fi

log "creating queue '$QUEUE' for serial $serial"
# udev re-triggers this unit whenever the USB device is re-enumerated, and the
# server may already have the queue by the time we get here. Treat the
# resulting "already exists" as success instead of failing the unit.
if ! out=$(/usr/bin/konica206-native add \
        -d "$QUEUE" \
        -u "$URI_BASE" \
        -m konica-bizhub-206 \
        -v "konica://KONICA%20MINOLTA/206?serial=${serial}" 2>&1); then
    if printf '%s\n' "$out" | grep -qi 'already exists'; then
        log "queue '$QUEUE' already exists"
        ensure_cups_queue
        exit 0
    fi
    printf '%s\n' "$out" >&2
    exit 1
fi

log "queue created: ${URI_BASE}/ipp/print/${QUEUE}"
ensure_cups_queue
