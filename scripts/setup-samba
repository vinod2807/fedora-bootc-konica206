#!/bin/bash
set -euo pipefail

# Runtime-only Samba/CUPS preparation.  Credentials are deliberately not baked
# into the bootc image; add the local user with `smbpasswd` after installation.
install -d -m 2770 -o root -g users /srv/samba/shared
install -d -m 1777 /var/spool/samba

# Permit Samba to serve home directories and label the extra share for SELinux.
if command -v setsebool >/dev/null 2>&1; then
    setsebool -P samba_enable_home_dirs on
fi
if command -v semanage >/dev/null 2>&1; then
    semanage fcontext -a -t samba_share_t '/srv/samba(/.*)?' 2>/dev/null || \
        semanage fcontext -m -t samba_share_t '/srv/samba(/.*)?'
    restorecon -RF /srv/samba
fi

# CUPS must advertise its queues to Samba, but it need not expose its admin UI.
# Printer sharing is baked into /etc/cups/cupsd.conf at image build time; only
# fall back to cupsctl when that configuration is missing (for example on an
# older deployment).  cupsd runs as a systemd on-demand service (cupsd -l), and
# every cupsctl config PUT makes it exit and restart -- which shows up in the
# boot log as "Scheduler shutting down due to program error" and a failed
# cups.service job.  The check itself only reads the settings, it does not PUT.
if command -v cupsctl >/dev/null 2>&1; then
    if ! cupsctl 2>/dev/null | grep -qx '_share_printers=1'; then
        cupsctl --share-printers || true
    fi
fi

exit 0
