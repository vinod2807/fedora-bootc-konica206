[Unit]
Description=Update NAPS2 Flatpak to the latest GitHub release
Documentation=https://github.com/vinod2807/fedora-bootc-konica206#automatic-flatpak-updates
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# Run as the desktop user: the installer writes profiles into $HOME, and
# passwordless sudo (already configured for vinod) covers the system Flatpak
# install. Root would create root-owned config files the user could not edit.
User=vinod
Environment=HOME=/var/home/vinod
ExecStart=/usr/libexec/naps2/update-naps2-flatpak
