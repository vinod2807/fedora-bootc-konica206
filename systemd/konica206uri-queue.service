[Unit]
Description=Create the legacy konica206uri printer application queue
Documentation=https://github.com/vinod2807/fedora-bootc-konica206/blob/main/docs/PRINTER.md
After=legacy-printer-app.service cups.service
Wants=legacy-printer-app.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/konica206/ensure-legacy-queue
# No printer attached, or the application not yet up, is normal.
SuccessExitStatus=0
TimeoutStartSec=120s

[Install]
WantedBy=multi-user.target
