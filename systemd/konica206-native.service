[Unit]
Description=Konica Minolta bizhub 206 PAPPL printer application
Documentation=https://github.com/vinod2807/fedora-bootc-konica206/blob/main/docs/PRINTER.md
After=network.target avahi-daemon.service
Wants=network.target avahi-daemon.service
# A permanent failure (e.g. no vendor data) should not spin forever.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=konica
Group=konica
SupplementaryGroups=lp
Environment=HOME=/var/lib/konica206
Environment=KONICA_VENDOR_FILTER=/usr/bin/konica-native
# The 206's duplexer binds the short edge. For long-edge output the back side
# must be pre-rotated 180°. CUPS's pdftoraster (used for the raster path that
# the shim PPD forces) honors *cupsBackSide: Rotated and performs this rotation.
# The native app also renders PDF directly for direct-IPP clients; it reads the
# same Rotated PPD via KONICA_PPD so its built-in renderer applies the same
# back-side rule. A readable PPD under /var/lib always wins over the compiled-in
# fallback, so an upgrade that stages the vendor Rotated PPD there would be
# correct; do not drop this variable.
Environment=KONICA_PPD=/usr/share/konica206/ppd/KonicaMinolta-206-fullbleed-rotated.ppd
Environment=KONICA_PDF_RENDERER=builtin
Environment=KONICA_LISTEN=localhost
Environment=KONICA_SPOOLDIR=/var/tmp
ExecStart=/usr/bin/konica206-native server -o server-port=8001
# Always: PAPPL exits cleanly when its Avahi connection goes away, and a clean
# exit would otherwise leave the printer offline until the next boot.
Restart=always
RestartSec=5s
UMask=0022

# Writable state: PAPPL keeps its queues/state under $HOME.
StateDirectory=konica206
StateDirectoryMode=0750
RuntimeDirectory=konica206
RuntimeDirectoryMode=0750

# Local spool files only; no shell, no home, no kernel/control-group access.
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
