[Unit]
Description=Konica Minolta bizhub 206 PAPPL printer application
Documentation=https://github.com/vinod2807/fedora-bootc-konica206/blob/main/docs/PRINTER.md
After=network.target avahi-daemon.service
Wants=network.target avahi-daemon.service
# A permanent failure (e.g. no vendor data) should not spin forever.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=konica
Group=konica
SupplementaryGroups=lp
Environment=HOME=/var/lib/konica206
Environment=KONICA_VENDOR_FILTER=/usr/bin/konica-native
# Duplex back-side rules differ per path. CUPS's pdftoraster (raster path that
# the shim PPD forces) and the legacy chain need *cupsBackSide: Rotated in their
# PPDs; leave those files untouched. The app's builtin PDF renderer also reads
# a PPD via KONICA_PPD, but must NOT pre-rotate duplex backs: since the switch
# to konica-native the 206's duplexer binds long edge on its own, and a Rotated
# app PPD prints the back upside down (2026-11-13 A/B, reproduced and fixed
# again 2026-11-22). The Normal copy is derived in the Containerfile. Do not
# drop this variable: a readable PPD overrides the compiled-in fallback.
Environment=KONICA_PPD=/usr/share/konica206/ppd/KonicaMinolta-206-native-normal.ppd
Environment=KONICA_PDF_RENDERER=builtin
Environment=KONICA_LISTEN=localhost
Environment=KONICA_SPOOLDIR=/var/tmp
ExecStart=/usr/bin/konica206-native server -o server-port=8001 -o listen=localhost
# PAPPL may start without binding its TCP listeners (e.g. transient bind failure at
# boot) yet keep running, leaving no IPP backend for CUPS. Verify port 8001 is
# listening; fail the start so systemd restarts the service.
ExecStartPost=/bin/sh -c 'for i in $(seq 1 30); do ss -H -ltn 2>/dev/null | grep -Eq ":(8001)[[:space:]]" && exit 0; sleep 1; done; exit 1'
# Always: PAPPL exits cleanly when its Avahi connection goes away, and a clean
# exit would otherwise leave the printer offline until the next boot.
Restart=always
RestartSec=5s
UMask=0022

# Writable state: PAPPL keeps its queues/state under $HOME.
StateDirectory=konica206
StateDirectoryMode=0755
RuntimeDirectory=konica206
RuntimeDirectoryMode=0750

# Local spool files only; no shell, no home, no kernel/control-group access.
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
